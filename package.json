{
  "name": "oliqualidade",
  "version": "0.5.0-beta.1",
  "private": true,
  "license": "UNLICENSED",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:dev": "npm run typecheck && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixture": "node scripts/generate-problematic-fixture.mjs",
    "test:corpus:generate": "node scripts/generate-workbook-corpus.mjs",
    "compatibility:report": "node scripts/check-workbook-compatibility.mjs",
    "corpus:sanitize": "node scripts/sanitize-workbook-corpus.mjs",
    "corpus:derive-templates": "node scripts/derive-real-templates.mjs",
    "corpus:validate": "node scripts/validate-sanitized-workbook-corpus.mjs",
    "test:security-smoke": "node scripts/security-smoke.mjs",
    "test:e2e": "playwright test",
    "graph:build": "node scripts/build-code-graph.mjs",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "benchmark:data": "node scripts/benchmark-large-import.mjs",
    "rust:test": "cargo test --locked --manifest-path rust/oli-ooxml-core/Cargo.toml",
    "wasm:build": "node scripts/build-ooxml-wasm.mjs",
    "wasm:smoke": "node scripts/test-ooxml-wasm.mjs",
    "wasm:corpus": "npm run test:corpus:generate && vitest run src/lib/wasm-shadow-corpus.test.ts src/lib/wasm-shadow-metrics.test.ts",
    "verify": "npm test && npm run build && npm run performance:check"
  },
