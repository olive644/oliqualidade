# Configure apenas no servidor. Nunca use prefixos VITE_ para segredos.
GEMINI_API_KEY=
OLI_SESSION_SECRET=
GEMINI_MODEL=gemini-3.6-flash

# Opcional: teto diário de chamadas reais da análise inteligente (cache não conta).
OLI_AI_IMPORT_DAILY_LIMIT=100

# Opcional: exija Bearer token no endpoint /api/gemini/chat.
OLI_CHAT_AUTH_TOKEN=

# Percentual de arquivos OOXML medidos pelo Rust/WASM em shadow mode (0 a 1).
# A seleção é determinística e nunca altera o resultado da importação.
VITE_WASM_SHADOW_SAMPLE_RATE=1

# Mantenha shadow/allowlist vazia até o gate por formato ser aprovado e revisado.
# Candidate mode verifica 100% dos XLSX e recua automaticamente em qualquer falha.
VITE_WASM_READER_MODE=shadow
VITE_WASM_CANDIDATE_FORMATS=
