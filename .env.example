# Configure apenas no servidor. Nunca use prefixos VITE_ para segredos.
GEMINI_API_KEY=
OLI_SESSION_SECRET=
GEMINI_MODEL=gemini-3.6-flash

# Opcional: teto diário de chamadas reais da análise inteligente (cache não conta).
OLI_AI_IMPORT_DAILY_LIMIT=100

# Opcional: exija Bearer token no endpoint /api/gemini/chat.
OLI_CHAT_AUTH_TOKEN=

# Opcional: limite de requisições compartilhado entre as instâncias da Vercel.
# Sem as duas variáveis o limite vale por instância e zera a cada reinício, que
# é o comportamento anterior. Os nomes são os que a integração Upstash da
# Vercel cria sozinha, então ligar a integração já basta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: verificação Cloudflare Turnstile antes de gastar cota de IA.
# Só liga com o par completo: o segredo fica no servidor e a chave do site vai
# para o navegador (por isso ela, e só ela, leva o prefixo VITE_).
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Percentual de arquivos OOXML medidos pelo Rust/WASM em shadow mode (0 a 1).
# A seleção é determinística e nunca altera o resultado da importação.
VITE_WASM_SHADOW_SAMPLE_RATE=1

# Rust/WASM materializa XLSX por padrão e recua automaticamente em qualquer diferença.
# Para rollback, use shadow e mantenha a allowlist inalterada: nenhuma mudança de
# código é necessária, mas o valor é embutido em tempo de build (Vite), então ainda
# é preciso um novo build/deploy (redeploy do commit atual basta). Ver "Como
# desativar o candidato Rust (rollback)" em docs/WASM_PROMOTION_CRITERIA.md.
VITE_WASM_READER_MODE=candidate
VITE_WASM_CANDIDATE_FORMATS=xlsx
