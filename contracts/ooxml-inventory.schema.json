{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oliqualidade.local/contracts/ooxml-inventory.schema.json",
  "title": "OliQualidade OOXML Workbook Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "dateSystem", "archive", "sheets", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "format": { "enum": ["ooxml", "ods"] },
    "dateSystem": { "enum": ["1900", "1904", "notApplicable"] },
    "archive": { "$ref": "#/$defs/archive" },
    "sheets": { "type": "array", "items": { "$ref": "#/$defs/sheet" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries",
        "compressedBytes",
        "uncompressedBytes",
        "maxCompressionRatio",
        "limits"
      ],
      "properties": {
        "entries": { "type": "integer", "minimum": 0 },
        "compressedBytes": { "type": "integer", "minimum": 0 },
        "uncompressedBytes": { "type": "integer", "minimum": 0 },
        "maxCompressionRatio": { "type": "number", "minimum": 0 },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxEntries",
            "maxSheets",
            "maxCells",
            "maxSharedStrings",
            "maxStructuralRecords",
            "maxTextBytes",
            "maxTotalUncompressedBytes",
            "maxEntryUncompressedBytes",
            "suspiciousRatioMinBytes",
            "maxCompressionRatio",
            "maxXmlEvents"
          ],
          "properties": {
            "maxEntries": { "type": "integer", "minimum": 1 },
            "maxSheets": { "type": "integer", "minimum": 1 },
            "maxCells": { "type": "integer", "minimum": 1 },
            "maxSharedStrings": { "type": "integer", "minimum": 1 },
            "maxStructuralRecords": { "type": "integer", "minimum": 1 },
            "maxTextBytes": { "type": "integer", "minimum": 1 },
            "maxTotalUncompressedBytes": { "type": "integer", "minimum": 1 },
            "maxEntryUncompressedBytes": { "type": "integer", "minimum": 1 },
            "suspiciousRatioMinBytes": { "type": "integer", "minimum": 0 },
            "maxCompressionRatio": { "type": "number", "exclusiveMinimum": 0 },
            "maxXmlEvents": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sheetId",
        "relationshipId",
        "path",
        "state",
        "declaredDimension",
        "actualDimension",
        "mergedRanges",
        "hiddenRows",
        "hiddenColumns",
        "cells"
      ],
      "properties": {
        "name": { "type": "string" },
        "sheetId": { "type": ["string", "null"] },
        "relationshipId": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "state": { "enum": ["visible", "hidden", "veryHidden"] },
        "declaredDimension": { "type": ["string", "null"] },
        "actualDimension": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "rows", "columns", "cellCount"],
              "properties": {
                "start": { "type": "string" },
                "end": { "type": "string" },
                "rows": { "type": "integer", "minimum": 1 },
                "columns": { "type": "integer", "minimum": 1 },
                "cellCount": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "mergedRanges": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\$?[A-Za-z]+\\$?[1-9][0-9]*:\\$?[A-Za-z]+\\$?[1-9][0-9]*$" }
        },
        "hiddenRows": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 1048576 }
        },
        "hiddenColumns": {
          "type": "array",
          "items": { "$ref": "#/$defs/hiddenColumnRange" }
        },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "hiddenColumnRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "end": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "cellType", "rawValue", "displayValue", "styleIndex"],
      "properties": {
        "address": { "type": "string" },
        "cellType": {
          "enum": ["blank", "number", "boolean", "string", "error", "date"]
        },
        "rawValue": { "type": ["string", "number", "boolean", "null"] },
        "displayValue": { "type": "string" },
        "styleIndex": { "type": "integer", "minimum": 0 },
        "numberFormat": { "type": "string" },
        "dateValue": {
          "type": "string",
          "pattern": "^-?[0-9]{4,}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "formula": { "type": "string" },
        "repeatColumns": { "type": "integer", "minimum": 2 },
        "repeatRows": { "type": "integer", "minimum": 2 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning"] },
        "message": { "type": "string" },
        "sheet": { "type": "string" }
      }
    }
  }
}
